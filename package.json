{
  "name": "aetherfall",
  "version": "0.0.0",
  "description": "A tower defence game where victory comes from how your towers combine.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck:sim",
    "typecheck:sim": "tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--expose-gc vitest run",
    "test:watch": "NODE_OPTIONS=--expose-gc vitest",
    "test:unit": "NODE_OPTIONS=--expose-gc vitest run",
    "test:determinism": "NODE_OPTIONS=--expose-gc vitest run tests/determinism --passWithNoTests",
    "content:lint": "node tools/content-lint/index.js",
    "balance": "node tools/balance-sim/index.js",
    "bundle:check": "node tools/bundle-budget/index.js",
    "changelog": "node tools/changelog/index.js",
    "test:coverage": "NODE_OPTIONS=--expose-gc vitest run --coverage"
  },
  "dependencies": {
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

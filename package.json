{
  "name": "aetherfall",
  "version": "0.0.0",
  "description": "A tower defence game where victory comes from how your towers combine.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck:sim",
    "typecheck:sim": "tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--expose-gc vitest run",
    "test:watch": "NODE_OPTIONS=--expose-gc vitest",
    "test:unit": "NODE_OPTIONS=--expose-gc vitest run",
    "test:determinism": "NODE_OPTIONS=--expose-gc vitest run tests/determinism",
    "content:lint": "tsx tools/content-lint/index.ts",
    "balance": "node tools/balance-sim/index.js",
    "bundle:check": "node tools/bundle-budget/index.js",
    "changelog": "node tools/changelog/index.js",
    "test:coverage": "NODE_OPTIONS=--expose-gc vitest run --coverage",
    "content:gen": "tsx tools/content-gen/index.ts",
    "pretypecheck": "npm run content:gen",
    "predev": "npm run generate",
    "pretest": "npm run generate",
    "precontent:lint": "npm run content:gen",
    "prepare": "npm run generate",
    "pretest:coverage": "npm run generate",
    "art:placeholder": "tsx tools/placeholder-art/index.ts",
    "atlas:build": "tsx tools/atlas-build/index.ts",
    "generate": "npm run content:gen && npm run atlas:build",
    "prebuild": "npm run generate",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "free-tex-packer-core": "^0.3.9",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

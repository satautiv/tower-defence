# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/install-state.gz

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# Generated — produced by build steps, never edited by hand
# Content id unions and typed cross-references (npm run content:gen)
src/content/generated/
# Texture atlases packed from source art by tools/atlas-build
public/assets/atlas/
# Balance simulator reports (tools/balance-sim)
reports/

# Testing
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Android / Capacitor
# The generated Android project is committed; its build artefacts are not.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
*.apk
*.aab
# Signing keys must never be committed
*.keystore
*.jks
keystore.properties

# IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
# Synced web build inside the Android project — regenerated by `cap sync`.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
